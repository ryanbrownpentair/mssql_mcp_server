# Default SQL Server Configuration
MSSQL_DEFAULT_SERVER=USCHITDB63-PTODS

# # SQL Server Configurations (server1, server2, ...)
# [default]
# MSSQL_AUTH_TYPE=sql
# MSSQL_SERVER=localhost
# MSSQL_USER=your_username
# MSSQL_PASSWORD=your_password
# MSSQL_DATABASE=your_database

# [production]
# MSSQL_AUTH_TYPE=sql
# MSSQL_SERVER=production-server
# MSSQL_USER=prod_username
# MSSQL_PASSWORD=prod_password
# MSSQL_DATABASE=production_db

# # Entra ID Authentication Example
# [azure]
# MSSQL_AUTH_TYPE=entra
# MSSQL_SERVER=your-server.database.windows.net
# MSSQL_DATABASE=your_database
# MSSQL_CLIENT_ID=your_app_client_id
# MSSQL_TENANT_ID=your_tenant_id
# MSSQL_CLIENT_SECRET=your_client_secret
# # MSSQL_ENTRA_USERNAME=your_email@domain.com
# # MSSQL_ENTRA_PASSWORD=your_password  # Optional, not recommended for security reasons

# # Interactive Authentication Example
# [azure-interactive]
# MSSQL_AUTH_TYPE=entra
# MSSQL_SERVER=your-server.database.windows.net
# MSSQL_DATABASE=your_database
# MSSQL_CLIENT_ID=your_app_client_id
# MSSQL_TENANT_ID=your_tenant_id
# MSSQL_AUTH_MODE=interactive  # Enables interactive auth
# MSSQL_TOKEN_CACHE_FILE=.mssql_token_cache.json  # Optional: Path to store token cache
# # MSSQL_USE_DEVICE_CODE=true  # Optional: Set to 'true' to use device code flow instead of browser-based auth

[USCHITDB63-PTODS]
MSSQL_AUTH_TYPE=windows
MSSQL_SERVER=USCHITDB63
MSSQL_DATABASE=PTODS
ENCRYPTION=optional

[USCHITDB63-WQSDW]
MSSQL_AUTH_TYPE=windows
MSSQL_SERVER=USCHITDB63
MSSQL_DATABASE=WQSDW
ENCRYPTION=optional

[USCHISDB26-SSISDB]
MSSQL_AUTH_TYPE=windows
MSSQL_SERVER=USCHISDB26
MSSQL_DATABASE=SSISDB
ENCRYPTION=optional
# Windows Authentication Example
# [windows-auth]
# MSSQL_AUTH_TYPE=windows
# MSSQL_SERVER=your-windows-server
# MSSQL_DATABASE=your_windows_database
# Windows認証ではユーザー名とパスワードは不要です。現在のWindowsセッションの資格情報が使用されます。


[azure-edw-dev]
MSSQL_AUTH_TYPE=entra
MSSQL_SERVER=sqlmi-dev-eastus-sapedw-001.6d7422421000.database.windows.net
MSSQL_DATABASE=EDW
MSSQL_CLIENT_ID=3279dcde-191f-446e-adac-83c51c6852ee
MSSQL_TENANT_ID=8237194f-de9d-4e96-b705-d713a214c4ea
MSSQL_AUTH_MODE=interactive
# MSSQL_USE_DEVICE_CODE=true
MSSQL_TOKEN_CACHE_FILE=.mssql_token_cache.json
ENCRYPTION=mandatory